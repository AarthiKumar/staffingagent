# Production Environment Configuration for aal.yookthi.ai
# Copy this file to .env.production and fill in the values

# ===================================
# Database Configuration
# ===================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_SECURE_PASSWORD_HERE
POSTGRES_DB=staffing

# ===================================
# MinIO Object Storage Configuration
# ===================================
MINIO_ROOT_USER=YOUR_MINIO_USER
MINIO_ROOT_PASSWORD=YOUR_SECURE_MINIO_PASSWORD
MINIO_BUCKET=originals

# ===================================
# Embeddings Configuration
# ===================================
# Provider: openai (recommended) or local
EMBEDDINGS_PROVIDER=openai
# For openai: text-embedding-3-small (recommended), text-embedding-3-large
# For local: sentence-transformers models (e.g., BAAI/bge-small-en)
EMBEDDINGS_MODEL=text-embedding-3-small

# ===================================
# LLM Configuration
# ===================================
LLM_PROVIDER=openai
LLM_API_KEY=sk-YOUR-OPENAI-API-KEY-HERE

# Optional LLM Features
ENABLE_LLM_RERANK=false
ENABLE_NL_ASSIST=false

# ===================================
# Auth0 Configuration
# ===================================
# Backend Auth0 settings
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=YOUR_AUTH0_CLIENT_ID
AUTH0_AUDIENCE=https://aal.yookthi.ai

# Frontend Auth0 settings (for build args)
VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=YOUR_AUTH0_CLIENT_ID
VITE_AUTH0_AUDIENCE=https://aal.yookthi.ai
VITE_API_BASE_URL=https://aal.yookthi.ai/api/v1

# ===================================
# Grafana Configuration
# ===================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=YOUR_SECURE_GRAFANA_PASSWORD
