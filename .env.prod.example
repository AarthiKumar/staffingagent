# Production Environment Variables
# Copy this file to .env.prod and fill in your actual values
# NEVER commit .env.prod to version control!

# ============================================================================
# DATABASE
# ============================================================================
DB_USER=postgres
DB_PASSWORD=your_secure_database_password_here
DB_NAME=staffing
DB_PORT=5432

# ============================================================================
# AUTH0 CONFIGURATION
# ============================================================================
# Get these from your Auth0 production tenant
AUTH0_ENABLED=true
AUTH0_DOMAIN=your-prod-tenant.auth0.com
AUTH0_CLIENT_ID=your_production_client_id
AUTH0_CLIENT_SECRET=your_production_client_secret
AUTH0_AUDIENCE=https://api.staffingagent.com
AUTH0_CALLBACK_URL=https://staffingagent.com/callback

# ============================================================================
# BACKEND CONFIGURATION
# ============================================================================
APP_NAME=Staffing Agent
CORS_ORIGINS=https://staffingagent.com,https://www.staffingagent.com
BACKEND_PORT=8000

# Embeddings
EMBEDDINGS_PROVIDER=sentence_transformers
EMBEDDINGS_MODEL=all-MiniLM-L6-v2

# Storage
MINIO_ENABLED=false

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
VITE_API_URL=https://api.staffingagent.com/api/v1
VITE_AUTH0_ENABLED=true
VITE_AUTH0_DOMAIN=your-prod-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your_production_client_id
VITE_AUTH0_AUDIENCE=https://api.staffingagent.com
VITE_AUTH0_REDIRECT_URI=https://staffingagent.com/callback

# ============================================================================
# PORT CONFIGURATION
# ============================================================================
FRONTEND_HTTP_PORT=80
FRONTEND_HTTPS_PORT=443

# ============================================================================
# SECURITY NOTES
# ============================================================================
# 1. Generate a strong database password (use: openssl rand -base64 32)
# 2. Never reuse development credentials in production
# 3. Store this file securely (use a password manager or secrets vault)
# 4. Rotate credentials regularly
# 5. Enable Auth0 MFA for production users
