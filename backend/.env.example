APP_ENV=dev
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/staffing
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=originals
STORAGE_LOCAL_PATH=./data/originals

# Embeddings Configuration
# Provider: local (sentence-transformers) or openai
EMBEDDINGS_PROVIDER=local
# For local: use sentence-transformers models (e.g., BAAI/bge-small-en, all-MiniLM-L6-v2)
# For openai: use text-embedding-3-small, text-embedding-3-large, or text-embedding-ada-002
EMBEDDINGS_MODEL=BAAI/bge-small-en

# LLM Configuration for Optional Features
# Provider: disabled, openai
# When set to 'openai', enables:
#   1. Consistent CV data extraction (Name, Email, Location, Summary, Skills, Experience, Certifications)
#   2. LLM-powered reranking of search results (if ENABLE_LLM_RERANK=true)
#   3. Natural language to filters conversion (if ENABLE_NL_ASSIST=true)
LLM_PROVIDER=disabled
# Required if LLM_PROVIDER=openai
LLM_API_KEY=

# Optional LLM Features (require LLM_PROVIDER=openai and LLM_API_KEY to be set)
# Enable LLM-powered reranking of search results (improves relevance)
ENABLE_LLM_RERANK=false
# Enable natural language to filters conversion (parse queries like "senior python dev with 5 years exp")
ENABLE_NL_ASSIST=false

OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5173/callback

PROMETHEUS_PORT=9001
