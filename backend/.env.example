APP_ENV=dev
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/staffing
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=originals
STORAGE_LOCAL_PATH=./data/originals

# Embeddings Configuration
# Provider: openai (recommended) or local (requires sentence-transformers with heavy dependencies)
EMBEDDINGS_PROVIDER=openai
# For openai: use text-embedding-3-small (recommended), text-embedding-3-large, or text-embedding-ada-002
# For local: use sentence-transformers models (e.g., BAAI/bge-small-en, all-MiniLM-L6-v2)
EMBEDDINGS_MODEL=text-embedding-3-small

# LLM Configuration
# Provider: openai (required for embeddings and CV extraction)
# When set to 'openai', enables:
#   1. OpenAI embeddings for semantic search (uses text-embedding-3-small by default)
#   2. Consistent CV data extraction (Name, Email, Location, Summary, Skills, Experience, Certifications)
#   3. LLM-powered reranking of search results (if ENABLE_LLM_RERANK=true)
#   4. Natural language to filters conversion (if ENABLE_NL_ASSIST=true)
LLM_PROVIDER=openai
# REQUIRED: Your OpenAI API key (get from https://platform.openai.com/api-keys)
LLM_API_KEY=sk-your-api-key-here

# Optional LLM Features (require LLM_PROVIDER=openai and LLM_API_KEY to be set)
# Enable LLM-powered reranking of search results (improves relevance)
ENABLE_LLM_RERANK=false
# Enable natural language to filters conversion (parse queries like "senior python dev with 5 years exp")
ENABLE_NL_ASSIST=false

OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5173/callback

PROMETHEUS_PORT=9001
